# =============================================================
# NK STORE — variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA coloque credenciais reais no repositório.
# =============================================================

# --- Banco de dados ---
# Desenvolvimento (SQLite, arquivo local):
DATABASE_URL="file:./prisma/dev.db"
# Produção (PostgreSQL/Neon), ex.: postgresql://usuario:senha@host/db?sslmode=require

# --- URL pública da loja (sem barra no final) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Autenticação do painel (NextAuth) ---
# Gere um valor aleatório: npx auth secret   (ou qualquer string longa e aleatória)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Admin de demonstração criado pelo seed ---
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# --- Mercado Pago (use SOMENTE credenciais de TESTE) ---
MP_ACCESS_TOKEN=""
NEXT_PUBLIC_MP_PUBLIC_KEY=""
# Assinatura secreta exibida no painel do MP em "Webhooks"
MP_WEBHOOK_SECRET=""
# "true" recusa notificações com assinatura inválida. Use em produção com
# credenciais reais, depois de confirmar que a assinatura confere. No sandbox
# com contas de teste deixe "false" (o MP assina com outra chave).
MP_WEBHOOK_STRICT_SIGNATURE="false"
# Opcional. Vazio (recomendado) = o MP usa a URL cadastrada no painel de Webhooks.
# Preenchido = cada pedido informa {URL}/api/webhooks/mercadopago ao MP.
MP_NOTIFICATION_BASE_URL=""

# --- Tarefas agendadas (Vercel Cron) ---
# Valor aleatório; protege /api/cron/expirar-pedidos
CRON_SECRET=""

# --- Frete ---
# "simulado" (padrão, não precisa de token) ou "melhorenvio"
SHIPPING_PROVIDER="simulado"
MELHOR_ENVIO_TOKEN=""
MELHOR_ENVIO_ENV="sandbox"
MELHOR_ENVIO_USER_AGENT="NK STORE (seu-email@exemplo.com)"

# --- Upload de imagens ---
# "local" (pasta public/uploads, só desenvolvimento) ou "vercel-blob"
STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""
