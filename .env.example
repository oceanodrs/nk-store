# =============================================================
# NK STORE — variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA coloque credenciais reais no repositório.
# =============================================================

# --- Banco de dados ---
# Desenvolvimento (SQLite, arquivo local):
DATABASE_URL="file:./prisma/dev.db"
# Produção (PostgreSQL/Neon): postgresql://usuario:senha@host/db?sslmode=require
# O projeto escolhe sozinho o schema/migrações certos pela URL (prisma.config.ts).
# Com o Neon, defina também a conexão direta (sem pooler), usada nas migrações:
# DATABASE_URL_UNPOOLED="postgresql://..."

# --- URL pública da loja (sem barra no final) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Autenticação do painel (NextAuth) ---
# Gere um valor aleatório com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Admin de demonstração criado pelo seed ---
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# --- Mercado Pago (use SOMENTE credenciais de TESTE) ---
MP_ACCESS_TOKEN=""
NEXT_PUBLIC_MP_PUBLIC_KEY=""
# Assinatura secreta exibida no painel do MP em "Webhooks"
MP_WEBHOOK_SECRET=""
# "true" recusa notificações com assinatura inválida. Use em produção com
# credenciais reais, depois de confirmar que a assinatura confere. No sandbox
# com contas de teste deixe "false" (o MP assina com outra chave).
MP_WEBHOOK_STRICT_SIGNATURE="false"
# Opcional. Vazio (recomendado) = o MP usa a URL cadastrada no painel de Webhooks.
# Preenchido = cada pedido informa {URL}/api/webhooks/mercadopago ao MP.
MP_NOTIFICATION_BASE_URL=""

# --- Tarefas agendadas (Vercel Cron) ---
# Valor aleatório; protege /api/cron/diario (cancela reservas vencidas e,
# em modo demonstração, restaura a loja todo dia às 3h de Brasília)
CRON_SECRET=""

# --- Modo demonstração (portfólio) ---
# "true" liga: reset diário dos dados, login de demonstração visível na tela
# de login do painel e configurações da loja travadas.
# NUNCA ligue numa loja real: o reset apaga pedidos e clientes.
DEMO_MODE="false"
DEMO_ADMIN_EMAIL=""
DEMO_ADMIN_PASSWORD=""

# --- Frete ---
# "simulado" (padrão, não precisa de token) ou "melhorenvio"
SHIPPING_PROVIDER="simulado"
MELHOR_ENVIO_TOKEN=""
MELHOR_ENVIO_ENV="sandbox"
MELHOR_ENVIO_USER_AGENT="NK STORE (seu-email@exemplo.com)"

# --- Upload de imagens ---
# "local" (pasta public/uploads, só desenvolvimento) ou "vercel-blob"
STORAGE_DRIVER="local"
# Na Vercel, conectar um Blob *Public* ao projeto cria BLOB_STORE_ID sozinho
# (autenticação automática). Fora da Vercel, use o token de leitura/escrita:
BLOB_READ_WRITE_TOKEN=""
