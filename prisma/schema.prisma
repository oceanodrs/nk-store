// NK STORE — modelo de dados
//
// Convenções:
// - Valores monetários sempre em CENTAVOS (Int). Ex.: R$ 199,90 => 19990.
// - Campos "enum" (status, tamanho, tipo de cupom) são String validados por Zod
//   e pelas constantes em src/lib/constants.ts (SQLite não tem enum nativo).
// - Para usar PostgreSQL em produção, troque o provider abaixo para "postgresql"
//   e gere novas migrações (veja README > Deploy).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String
  price       Int // centavos
  salePrice   Int? // centavos; preço promocional opcional
  active      Boolean          @default(true)
  featured    Boolean          @default(false)
  weightGrams Int              @default(300)
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images      ProductImage[]
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoryId])
  @@index([active, featured])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  position  Int     @default(0)

  @@index([productId])
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String // P | M | G | GG | XG
  stock      Int         @default(0)
  reserved   Int         @default(0) // unidades presas em pedidos aguardando pagamento
  orderItems OrderItem[]

  @@unique([productId, size])
}

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  cpf       String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  // O id sequencial é exibido como NK-000123. Ele nunca dá acesso ao pedido
  // sozinho: o acompanhamento exige número + e-mail, e as páginas de retorno
  // usam o accessToken aleatório.
  id                   Int                  @id @default(autoincrement())
  accessToken          String               @unique
  status               String               @default("AWAITING_PAYMENT")
  customerId           String
  customer             Customer             @relation(fields: [customerId], references: [id])
  // snapshot dos dados do cliente e endereço no momento da compra
  customerName         String
  customerEmail        String
  customerPhone        String
  customerCpf          String?
  zipCode              String
  street               String
  number               String
  complement           String?
  district             String
  city                 String
  state                String
  // valores em centavos, sempre calculados no servidor
  subtotal             Int
  discount             Int                  @default(0)
  shippingCost         Int
  total                Int
  shippingService      String
  shippingDays         Int?
  couponCode           String?
  trackingCode         String?
  // Mercado Pago
  mpPreferenceId       String?
  mpPaymentId          String?
  paymentMethod        String?
  paidAt               DateTime?
  reservationExpiresAt DateTime?
  items                OrderItem[]
  history              OrderStatusHistory[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([status])
  @@index([customerEmail])
  @@index([createdAt])
}

model OrderItem {
  id          String         @id @default(cuid())
  orderId     Int
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productName String
  productSlug String
  size        String
  unitPrice   Int
  quantity    Int
  imageUrl    String?

  @@index([orderId])
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus  String
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String // PERCENT | FIXED
  value       Int // PERCENT: 1–100 | FIXED: centavos
  minSubtotal Int? // centavos
  startsAt    DateTime?
  expiresAt   DateTime?
  usageLimit  Int?
  usedCount   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Linha única (id = 1) com as configurações editáveis pelo painel.
// Credenciais NUNCA ficam aqui: só em variáveis de ambiente.
model StoreSettings {
  id                    Int      @id @default(1)
  storeName             String   @default("NK STORE")
  logoUrl               String?
  email                 String?
  phone                 String?
  whatsapp              String?
  instagram             String?
  address               String?
  originZipCode         String   @default("01310100")
  freeShippingThreshold Int? // centavos; null = sem frete grátis
  updatedAt             DateTime @updatedAt
}

// Registro de webhooks processados (idempotência).
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  externalId  String
  action      String?
  payload     String
  processedAt DateTime @default(now())

  @@unique([provider, externalId, action])
}
